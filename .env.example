# ARC — Adversarial Reasoning Chain — API Keys
# Copy this file to .env and fill in your keys.
#
# Claude API is OPTIONAL — you can paste responses from claude.ai instead.
# GPT and Gemini are the core review/audit pipeline.

# Optional: enables "Auto-fill via API" button for Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Required for GPT review phase
OPENAI_API_KEY=your_openai_key_here

# Required for Gemini audit phase
GOOGLE_API_KEY=your_google_api_key_here
